// Behavioral Prep — data model.
// Source of truth for the domain is docs/SPEC.md §10–§12; deviations are in docs/DECISIONS.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id
  email String  @unique
  name  String?

  stories  Story[]
  attempts PracticeAttempt[]
  audio    AttemptAudio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// System-owned. Seeded from src/data/questions.ts; users never create or edit these.
model Question {
  id         String     @id
  text       String
  competency Competency

  attempts PracticeAttempt[]

  createdAt DateTime @default(now())

  @@index([competency])
}

model Story {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  attempts PracticeAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// The central object. Everything else exists to give an attempt context.
model PracticeAttempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  // Deleting a story must never delete its attempts — the storyId is nulled instead (SPEC §16).
  storyId String?
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: SetNull)

  /// What the user saved. For a spoken attempt this starts as `transcript` and
  /// may then be edited, so the two can legitimately differ.
  response     String
  responseType ResponseType @default(TEXT)
  /// Raw speech-to-text output, kept unedited so the recording and the text it
  /// produced can always be compared. Null for typed attempts.
  transcript   String?

  /// The recording itself, in its own table so listing attempts never risks
  /// dragging megabytes of audio along (see docs/DECISIONS.md ADR-010).
  audio AttemptAudio?

  durationSeconds Int?
  reflection      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@index([userId, storyId])
}

/// The audio bytes for a spoken attempt.
///
/// Split out from PracticeAttempt so that a `bytea` of several megabytes never
/// loads as a side effect of listing history. `userId` is denormalized here so
/// the playback route can scope by owner in a single query.
model AttemptAudio {
  id String @id @default(cuid())

  attemptId String          @unique
  attempt   PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  data     Bytes
  mimeType String
  byteSize Int

  createdAt DateTime @default(now())

  @@index([userId])
}

enum ResponseType {
  TEXT
  AUDIO
}

enum Competency {
  TEAMWORK
  CONFLICT
  LEADERSHIP
  FAILURE
  AMBIGUITY
  COMMUNICATION
  TECHNICAL_CHALLENGE
  LEARNING
  TIME_MANAGEMENT
  FEEDBACK
  MOTIVATION
}
