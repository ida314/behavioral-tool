# Copy to .env and adjust if needed.
# Matches the Postgres service in docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://behavioral:behavioral@localhost:5433/behavioral_prep?schema=public"

# Dev-only stub auth (see src/lib/auth.ts and docs/DECISIONS.md ADR-003).
# Every request is attributed to this user until a real auth provider is wired up.
DEV_USER_ID="dev-user"
DEV_USER_EMAIL="dev@example.com"
DEV_USER_NAME="Dev User"
