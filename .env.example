# Copy to .env and adjust if needed.
# Matches the Postgres service in docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://behavioral:behavioral@localhost:5433/behavioral_prep?schema=public"

# Dev-only stub auth (see src/lib/auth.ts and docs/DECISIONS.md ADR-003).
# Every request is attributed to this user until a real auth provider is wired up.
DEV_USER_ID="dev-user"
DEV_USER_EMAIL="dev@example.com"
DEV_USER_NAME="Dev User"

# Local speech-to-text for spoken answers (docs/DECISIONS.md ADR-010).
# `npm run whisper:setup` puts the binary and model exactly where the app looks
# by default, so these only need setting to move them or use a bigger model.
# WHISPER_BIN=".whisper/whisper.cpp/build/bin/whisper-cli"
# WHISPER_MODEL=".whisper/models/ggml-base.en.bin"
# WHISPER_THREADS="4"
